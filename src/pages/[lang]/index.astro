---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { localizedUrl } from '../../utils/url';
import { siteMeta, useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
	return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const meta = siteMeta[lang];

const posts = (await getCollection('blog'))
	.filter((post) => post.id.startsWith(`${lang}/`))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const slugOf = (id: string) => id.replace(/^[a-z]{2}\//, '');
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={meta.title} description={meta.description} />
		<style>
			main {
				width: 840px;
			}
			.intro {
				color: rgb(var(--gray));
				margin: 0 0 2.5rem;
				font-size: 1.05rem;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li a {
				display: grid;
				grid-template-columns: 220px 1fr;
				gap: 1.5rem;
				align-items: center;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				box-shadow: var(--box-shadow-soft);
				overflow: hidden;
				text-decoration: none;
				transition:
					transform 0.18s ease,
					box-shadow 0.18s ease;
			}
			li a:hover {
				transform: translateY(-3px);
				box-shadow: var(--box-shadow-hover);
			}
			li img {
				width: 100%;
				height: 140px;
				object-fit: cover;
				border-radius: 0;
			}
			.entry {
				padding: 1.25rem 1.5rem 1.25rem 0;
			}
			.entry .title {
				margin: 0 0 0.3rem;
				color: rgb(var(--black));
				font-size: 1.3rem;
			}
			.entry .desc {
				margin: 0 0 0.5rem;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
			}
			.entry .date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.8rem;
			}
			li a:hover .title {
				color: var(--primary-dark);
			}
			/* 沒有題圖的文章：純文字卡片、全寬 */
			li a.no-image {
				grid-template-columns: 1fr;
			}
			li a.no-image .entry {
				padding: 1.5rem;
			}
			/* 純文字卡片只顯示標題 */
			li a.no-image .desc,
			li a.no-image .date {
				display: none;
			}
			li a.no-image .title {
				margin: 0;
			}
			@media (max-width: 640px) {
				li a {
					grid-template-columns: 1fr;
				}
				li img {
					height: 180px;
				}
				.entry {
					padding: 0 1.25rem 1.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{meta.title}</h1>
			<p class="intro">{t('home.intro')}</p>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={localizedUrl(lang, slugOf(post.id))} class={post.data.heroImage ? undefined : 'no-image'}>
								{post.data.heroImage && (
									<Image width={440} height={280} src={post.data.heroImage} alt="" />
								)}
								<div class="entry">
									<h2 class="title">{post.data.title}</h2>
									<p class="desc">{post.data.description}</p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
