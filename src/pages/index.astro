---
import { localizedUrl } from '../utils/url';
import { defaultLang } from '../i18n/ui';

const target = localizedUrl(defaultLang);
---

<!doctype html>
<html lang={defaultLang}>
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={target} />
		<title>Niwa Day</title>
	</head>
	<body>
		<a href={target}>Niwa Day Dev Log</a>
		<script is:inline set:html={`location.replace(${JSON.stringify(target)});`}></script>
	</body>
</html>
