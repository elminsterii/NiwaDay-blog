---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import { url, localizedUrl } from '../utils/url';
import { getLang, siteMeta } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;

const lang = getLang(Astro.currentLocale);

// 解析路徑中語言之後的「其餘部分」，用來產生 hreflang 對應連結
const baseNoSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const cleanPath = Astro.url.pathname.replace(/\/$/, '');
const rel = cleanPath.startsWith(baseNoSlash) ? cleanPath.slice(baseNoSlash.length) : cleanPath;
const segs = rel.split('/').filter(Boolean);
const rest = segs.slice(1).join('/');
const isLocalized = segs[0] === 'zh' || segs[0] === 'en';

const posts = await getCollection('blog');
const slugsByLang: Record<string, Set<string>> = {};
for (const post of posts) {
	const [l, ...r] = post.id.split('/');
	(slugsByLang[l] ??= new Set()).add(r.join('/'));
}

const hreflangCode: Record<string, string> = { zh: 'zh-Hant', en: 'en' };

function pageUrlFor(code: string): string | null {
	if (!rest) return localizedUrl(code);
	if (rest === 'about') return localizedUrl(code, 'about');
	if (slugsByLang[code]?.has(rest)) return localizedUrl(code, rest);
	return null;
}

const alternates = isLocalized
	? (['zh', 'en'] as const)
			.map((code) => ({ code, href: pageUrlFor(code) }))
			.filter((a): a is { code: 'zh' | 'en'; href: string } => a.href !== null)
	: [];
const xDefault = isLocalized ? (pageUrlFor('zh') ?? pageUrlFor('en')) : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
<link rel="icon" href={url('favicon.ico')} />
<link rel="sitemap" href={url('sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteMeta[lang].title}
	href={new URL(url(`${lang}/rss.xml`), Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-noto" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang 語言對應 -->
{
	alternates.map((a) => (
		<link rel="alternate" hreflang={hreflangCode[a.code]} href={new URL(a.href, Astro.site)} />
	))
}
{xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site)} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />
