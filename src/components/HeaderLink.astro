---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { active?: boolean };

const { href, class: className, active, ...props } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const target = href!.toString().replace(/\/$/, '') || '/';
// 預設：完全相符，或為其子頁面；可由 active 屬性覆寫。
const computed = current === target || current.startsWith(target + '/');
const isActive = active ?? computed;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: 700;
		color: var(--accent);
	}
</style>
