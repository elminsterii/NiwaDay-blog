---
import { getCollection } from 'astro:content';
import HeaderLink from './HeaderLink.astro';
import { localizedUrl } from '../utils/url';
import { getLang, useTranslations, languages, siteMeta } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const title = siteMeta[lang].title;

const path = Astro.url.pathname.replace(/\/$/, '');
const homePath = localizedUrl(lang).replace(/\/$/, '');
const aboutPath = localizedUrl(lang, 'about').replace(/\/$/, '');
const isAbout = path === aboutPath;
const isHome = !isAbout && path.startsWith(homePath);

// 找出目前頁面在路徑中、語言之後的「其餘部分」（slug 或 about），
// 以便語言切換能對應到另一語言的同一頁。
const baseNoSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
let rel = path.startsWith(baseNoSlash) ? path.slice(baseNoSlash.length) : path;
const segs = rel.split('/').filter(Boolean); // 例如 ['zh','welcome']
const rest = segs.slice(1).join('/'); // 'welcome' / 'about' / ''

// 各語言現有文章 slug，用來判斷另一語言是否有對應文章
const posts = await getCollection('blog');
const slugsByLang: Record<string, Set<string>> = {};
for (const post of posts) {
	const [l, ...r] = post.id.split('/');
	(slugsByLang[l] ??= new Set()).add(r.join('/'));
}

function switchTarget(code: string): string {
	if (!rest) return localizedUrl(code); // 首頁
	if (rest === 'about') return localizedUrl(code, 'about');
	if (slugsByLang[code]?.has(rest)) return localizedUrl(code, rest); // 同篇存在
	return localizedUrl(code); // 否則回到該語言日誌首頁
}
---

<header>
	<nav>
		<a class="brand" href={localizedUrl(lang)}>{title}</a>
		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href={localizedUrl(lang)} active={isHome}>{t('nav.home')}</HeaderLink>
				<HeaderLink href={localizedUrl(lang, 'about')} active={isAbout}>{t('nav.about')}</HeaderLink>
			</div>
			<div class="lang-switch">
				{
					Object.entries(languages).map(([code, label], i) => (
						<Fragment>
							{i > 0 && <span class="sep">/</span>}
							<a href={switchTarget(code)} class:list={['lang', { active: code === lang }]}>
								{label}
							</a>
						</Fragment>
					))
				}
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.25em;
		background: rgba(255, 255, 255, 0.85);
		backdrop-filter: saturate(140%) blur(8px);
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
	}
	.brand {
		font-weight: 700;
		font-size: 1.05rem;
		color: rgb(var(--black));
		text-decoration: none;
		padding: 0.9em 0;
		letter-spacing: -0.01em;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.25em;
	}
	.internal-links {
		display: flex;
		gap: 0.25em;
	}
	.internal-links :global(a) {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.35em;
		font-size: 0.9rem;
	}
	.lang-switch .lang {
		color: rgb(var(--gray));
		text-decoration: none;
		padding: 0.2em 0.1em;
	}
	.lang-switch .lang.active {
		color: var(--accent);
		font-weight: 700;
	}
	.lang-switch .sep {
		color: var(--border);
	}
	@media (max-width: 720px) {
		.brand {
			font-size: 0.95rem;
		}
		.nav-right {
			gap: 0.75em;
		}
	}
</style>
