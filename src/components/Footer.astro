---
import { getLang, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer>
	<a class="home" href="https://niwaday.com/">niwaday.com</a>
	<p class="rights">© {year} Niwa Day · {t('footer.rights')}</p>
	<p class="contact"><a href="mailto:elminsterii2@gmail.com">elminsterii2@gmail.com</a></p>
</footer>
<style>
	footer {
		padding: 3em 1em 4em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9rem;
		border-top: 1px solid var(--border);
		margin-top: 4em;
	}
	footer .home {
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}
	footer p {
		margin: 0.5em 0 0;
	}
	footer a {
		color: rgb(var(--gray));
	}
	footer .contact a {
		color: var(--accent);
		text-decoration: none;
	}
</style>
